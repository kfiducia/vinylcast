# vinylcast display backend — secrets/config for the vinyl ACR recognizer.
#
# Copy to /etc/vinylcast/vinylcast.env on the Pi (root:root, chmod 600) and fill in
# your ACRCloud project credentials. This file is loaded by vinylcast-display.service
# via `EnvironmentFile=`. Do NOT commit the real file — the repo is public.
#
# Recognizer provider: acrcloud (default) or acoustid (free — needs fpcalc + a free app key)
# VINYL_ACR_PROVIDER=acrcloud

# --- ACRCloud (only when VINYL_ACR_PROVIDER=acrcloud, the default) ---
# Get these from an "Audio & Video Recognition" project at https://console.acrcloud.com
ACRCLOUD_HOST=identify-us-west-2.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_access_key_here
ACRCLOUD_ACCESS_SECRET=your_access_secret_here

# --- AcoustID (only when VINYL_ACR_PROVIDER=acoustid) ---
# Free application key from https://acoustid.org/new-application (no billing, no per-lookup cost).
# Also requires the fpcalc binary: sudo apt install -y libchromaprint-tools
# ACOUSTID_CLIENT_KEY=your_acoustid_app_key_here
# VINYL_ACOUSTID_MIN_SCORE=0.5     # 0..1; higher = fewer but more-confident matches on noisy vinyl

# Optional tuning (defaults shown):
# VINYL_ADC=vinyl_snoop_mono      # ALSA device the sampler records from (see /etc/asound.conf)
# VINYL_SAMPLE_SECS=10            # clip length per recognition attempt
# VINYL_RECHECK_SECS=90           # how often to re-identify while a side plays
